# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=jobpipe
MACHINE_API_KEY=replace-with-a-long-random-string
# Signs the review page's login cookie. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to true when the review page is served over HTTPS, so the cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=false
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
