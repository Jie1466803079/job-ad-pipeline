# Run `make env` to create .env from this file with new random secrets, or to add the keys an
# existing .env is missing. It never changes a value already set. Never commit .env.
# Wrap a value in single quotes if it contains a $ sign.
POSTGRES_PASSWORD=jobpipe
# The key n8n sends to intake-api's /machine routes.
MACHINE_API_KEY=
# Signs the review page's login cookie.
SESSION_SECRET=
# Set to true when the review page is served over HTTPS, so the cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=false
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# n8n. Job-link requests send WEBHOOK_SECRET in the X-Webhook-Secret header.
WEBHOOK_SECRET=
# Encrypts the credentials n8n stores. Never change it once n8n has started: n8n keeps a copy in its
# data volume and refuses to start when the two differ.
N8N_ENCRYPTION_KEY=
# n8n's login cookie is Secure. Chrome accepts it on http://127.0.0.1; Safari does not, so set this to
# false to use n8n in Safari.
N8N_SECURE_COOKIE=true

# Email. By default n8n sends to Mailpit, which keeps every message at http://127.0.0.1:8025 and
# delivers none. For a real mail server, fill these in and run `make n8n-setup` again.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true for TLS from the start (usually port 465). With false, the connection is upgraded to TLS when the
# server offers it.
SMTP_SECURE=false
MAIL_FROM=jobpipe@localhost
DIGEST_TO=you@example.com
ALERT_TO=you@example.com
# Where the links in the digest email point.
REVIEW_URL=http://127.0.0.1:8000
